POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/
API_KEY=local-development-key
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
PAYMENT_MIN_DELAY_SECONDS=2
PAYMENT_MAX_DELAY_SECONDS=5
PAYMENT_FAILURE_RATE=0.10
WEBHOOK_TIMEOUT_SECONDS=5
RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

